# ==============================================================================
# Environment Configuration Template
# Copy this file to '.env' and fill in your private credentials.
# Note: NEVER commit the actual '.env' file containing secrets to git.
# ==============================================================================

# DagsHub / MLflow Tracking Credentials
# Obtain your user token from: https://dagshub.com/user/settings/tokens
DAGSHUB_USER_TOKEN=your_dagshub_token_here
MLFLOW_TRACKING_USERNAME=your_dagshub_username_here
MLFLOW_TRACKING_PASSWORD=your_dagshub_token_or_password_here

# Kaggle API Credentials (Required only for running src.data.download)
# Option A: Modern Kaggle API Token (Single Bearer Token)
KAGGLE_API_KEY=KGAT_your_api_token_here

# Option B: Legacy Kaggle Credentials (Username + Key Pair)
# KAGGLE_USERNAME=your_kaggle_username_here
# KAGGLE_KEY=your_kaggle_api_key_here

# Optional Container Admin Credentials (Defaults to admin/admin if omitted)
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
